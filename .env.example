# --- Real-estate Supabase project (server-only; service role bypasses RLS) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# --- Accounts/chat Supabase project (optional: chat persistence) ---
ACCOUNTS_SUPABASE_URL=
ACCOUNTS_SUPABASE_SERVICE_ROLE_KEY=

# --- LLM providers (tried in LLM_PROVIDER_ORDER; a failing one is skipped by a circuit breaker) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional smaller/faster model just for routing:
GROQ_ROUTER_MODEL=
OPENROUTER_API_KEY=
# MUST be a slug currently served for your account. `openai/gpt-oss-120b:free` returns 404.
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
NVIDIA_API_KEY=
NVIDIA_CHAT_MODEL=meta/llama-3.2-11b-vision-instruct
LLM_PROVIDER_ORDER=groq,openrouter,nvidia

# --- Embeddings: NVIDIA_API_KEY above (nvidia/nemotron-3-embed-1b) ---

# --- Rate limiting (recommended in production; in-memory fallback otherwise) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Auth (browser-side, public by design: the ANON key of the ACCOUNTS Supabase project) ---
# These are inlined at BUILD time. Never put a service_role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_ACCOUNTS_SUPABASE_URL=
NEXT_PUBLIC_ACCOUNTS_SUPABASE_ANON_KEY=

# --- Daily trial limits (optional overrides) ---
# QUOTA_ANON_PER_IP=5        # visitors without an account, per IP per day
# QUOTA_USER_PER_EMAIL=5     # verified email, per day
# QUOTA_USER_PER_IP=20       # cap across many emails from one IP
# QUOTA_GLOBAL_PER_DAY=300   # whole-project hard stop
# UPSTASH_* above is REQUIRED in production (the counter fails closed without it).

# --- Backend-only deployment ---
# Origins of your real frontend allowed to call /api/chat (comma-separated, no trailing slash).
# Leave empty if the frontend is served from the same domain as this API.
ALLOWED_ORIGINS=
# Optional: visitors opening the API root are redirected here.
FRONTEND_URL=
