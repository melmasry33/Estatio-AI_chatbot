# --- Real-estate Supabase project ---
SUPABASE_URL=https://your-property-project.supabase.co
# Server-only key for property search and RPCs
SUPABASE_SERVICE_ROLE_KEY=your-property-service-role-key

# --- Accounts/chat Supabase project ---
ACCOUNTS_SUPABASE_URL=https://your-accounts-project.supabase.co
# Server-only key for chat history persistence
ACCOUNTS_SUPABASE_SERVICE_ROLE_KEY=your-accounts-service-role-key

# --- Primary LLM Provider (Google Gemini 2.0 Flash) ---
OPENROUTER_API_KEY=your-openrouter-api-key

# --- Fallback LLM Provider (Groq Llama 3.3) ---
GROQ_API_KEY=your-groq-api-key

# --- Embedding Provider (NVIDIA Nemotron-3-Embed-1B) ---
NVIDIA_API_KEY=your-nvidia-api-key

# --- Upstash Redis (Optional for Edge Rate Limiting) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Service Port ---
PORT=3000
